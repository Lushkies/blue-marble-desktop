<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BlueMarbleDesktop</AssemblyName>
    <RootNamespace>DesktopEarth</RootNamespace>
    <ApplicationIcon>Resources\bluemarbledesktop.ico</ApplicationIcon>
    <Version>2.2.2</Version>
    <FileVersion>2.2.2.0</FileVersion>
    <AssemblyVersion>2.2.2.0</AssemblyVersion>
    <Product>Blue Marble Desktop</Product>
    <Company>Blue Marble Desktop</Company>
    <Authors>Alex and Claude (Anthropic)</Authors>
    <Description>Dynamic wallpaper showing a 3D Earth with real-time day/night illumination</Description>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\bluemarbledesktop.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    ImageSharp 3.2+ Release builds need a Six Labors license (Community license, valid
    until 2028-02-05). It is read from sixlabors.lic in the repo root, which is
    gitignored: this repo is public and the key must never be committed. On another
    machine or CI, set the SixLaborsLicenseKey property / environment variable instead.
    (The package itself only searches below this project folder, hence the explicit path.)
  -->
  <PropertyGroup Condition="'$(SixLaborsLicenseKey)' == '' and '$(SixLaborsLicenseFile)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\sixlabors.lic')">
    <SixLaborsLicenseFile>$(MSBuildThisFileDirectory)..\..\sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.0" />
  </ItemGroup>

</Project>
