<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>BlueMarbleDesktop</AssemblyName>
    <RootNamespace>DesktopEarth</RootNamespace>
    <ApplicationIcon>Resources\bluemarbledesktop.ico</ApplicationIcon>
    <Version>2.2.1</Version>
    <FileVersion>2.2.1.0</FileVersion>
    <AssemblyVersion>2.2.1.0</AssemblyVersion>
    <Product>Blue Marble Desktop</Product>
    <Company>Blue Marble Desktop</Company>
    <Authors>Alex and Claude (Anthropic)</Authors>
    <Description>Dynamic wallpaper showing a 3D Earth with real-time day/night illumination</Description>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\bluemarbledesktop.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    WORKAROUND (2026-10, updated 2026-11): ImageSharp 3.1.12 has advisories fixed in
    3.2.0 / 4.1.2+, but those versions' Release builds require a Six Labors license key
    (free for open source: https://sixlabors.com/pricing/; checked 2026-11: 3.2.0 fails
    a Release build without one). Until the project has one, stay on 3.1.12 and
    suppress ONLY these advisories, each reviewed against how this app uses ImageSharp:
      gwg2 (ICC CLUT parsing)      - mitigated: every decode sets SkipMetadata (ImageDecoding.cs)
      wmxv (BigTIFF IFD loop)      - not reachable: ImageDecoding.cs registers no TIFF decoder
      v76p (tiled fax TIFF heap overwrite) - not reachable: same, no TIFF decoder
      j3p4 (HistogramEqualization) - not reachable: the app never calls it
      j9gm / jjfr (TIFF CCITT T4/T6 encoders) - not reachable: the app never encodes TIFF
    Every decode must go through ImageDecoding.Options / WithTargetSize, or these
    justifications stop holding.
    Proper fix: get a license key, upgrade to 3.2.0+ (or 4.1.3), then delete this block.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

</Project>
